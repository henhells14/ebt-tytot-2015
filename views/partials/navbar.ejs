<header>
    <div class="header-left">
        <a href="/" style="display: flex; align-items: center; text-decoration: none;">
            <div class="ebt-logo"></div>
            <span class="tytot-text">Tytöt 2015 →</span>
        </a>

        <div class="basketball-nav" onclick="toggleNav()">🏀</div>
        
        <div class="nav-menu">
            <a href="/" class="nav-btn <%= page === 'koti' ? 'active' : '' %>">Koti</a>
            <a href="/sarjataulukko" class="nav-btn <%= page === 'sarjataulukko' ? 'active' : '' %>">Sarjataulukko</a>
            <a href="/ottelut" class="nav-btn <%= page === 'ottelut' ? 'active' : '' %>">Ottelut</a>
            <a href="/pelaajat" class="nav-btn <%= page === 'pelaajat' ? 'active' : '' %>">Pelaajat</a>
            
            <a href="https://team-gallery.vercel.app/" class="nav-btn" target="_blank">Galleria</a>
        </div>
    </div>
    
    <div class="mobile-nav">
        <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="mobile-menu">
            <a href="/" class="<%= page === 'koti' ? 'active' : '' %>">Koti</a>
            <a href="/sarjataulukko" class="<%= page === 'sarjataulukko' ? 'active' : '' %>">Sarjataulukko</a>
            <a href="/ottelut" class="<%= page === 'ottelut' ? 'active' : '' %>">Ottelut</a>
            <a href="/pelaajat" class="<%= page === 'pelaajat' ? 'active' : '' %>">Pelaajat</a>
            
            <a href="https://team-gallery.vercel.app/" target="_blank">Galleria</a>
        </div>
    </div>
</header>

<script>
    // --- DESKTOP NAVIGAATIO (Pallo pyörii) ---
    let navOpen = false;

    function toggleNav() {
        const basketball = document.querySelector('.basketball-nav');
        const navMenu = document.querySelector('.nav-menu');
        
        // Lasketaan dynaamisesti kuinka leveä valikko on
        const menuWidth = navMenu.offsetWidth || 700; // Kasvatin oletusleveyttä hieman, koska nappi tuli lisää
        const rollDistance = menuWidth + 100; 

        if (!navOpen) {
            basketball.style.transform = `translateX(${rollDistance}px) rotate(360deg)`;
            navMenu.classList.add('show');
            navOpen = true;
        } else {
            basketball.style.transform = 'translateX(0) rotate(0deg)';
            navMenu.classList.remove('show');
            navOpen = false;
        }
    }

    // --- MOBILE NAVIGAATIO (Hamburger) ---
    let mobileNavOpen = false;

    function toggleMobileNav() {
        const hamburger = document.querySelector('.hamburger');
        const mobileMenu = document.querySelector('.mobile-menu');
        
        if (hamburger && mobileMenu) {
            if (!mobileNavOpen) {
                hamburger.classList.add('open');
                mobileMenu.classList.add('show');
                mobileNavOpen = true;
            } else {
                hamburger.classList.remove('open');
                mobileMenu.classList.remove('show');
                mobileNavOpen = false;
            }
        }
    }

    // --- EVENT LISTENERIT ---
    document.addEventListener('DOMContentLoaded', function() {
        const hamburger = document.querySelector('.hamburger');
        if (hamburger) {
            hamburger.addEventListener('click', toggleMobileNav);
        }
    });

    // Sulje navigaatio jos klikataan valikon ohi
    document.addEventListener('click', function(e) {
        // Desktop
        const headerLeft = document.querySelector('.header-left');
        if (navOpen && headerLeft && !headerLeft.contains(e.target)) {
            toggleNav();
        }

        // Mobiili
        const mobileNav = document.querySelector('.mobile-nav');
        if (mobileNavOpen && mobileNav && !mobileNav.contains(e.target)) {
            toggleMobileNav();
        }
    });
</script>